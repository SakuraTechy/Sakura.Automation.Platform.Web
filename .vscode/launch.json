{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "启动本地Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${workspaceFolder}/src/*"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "启动远程Chrome",
      "url": "http://172.19.1.111:5173",
      "port": 5173,
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${workspaceFolder}/src/*"
      }
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Remote Browser",
      "port": 5173,
      "address": "172.19.1.111",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${workspaceFolder}/src/*"
      }
    },
    {
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "name": "Firefox: Remote",
      "url": "http://172.19.1.111:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Edge: Remote",
      "type": "msedge",
      "request": "launch",
      "url": "http://172.19.1.111:5173", // 例如 "http://123.456.789.0:3000"
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ]
}
